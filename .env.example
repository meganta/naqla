# Environment: dev or prod
ENVIRONMENT=dev

# Database
DATABASE_URL=postgresql+asyncpg://naqla:naqla@localhost:5432/naqla_dev

# JWT
JWT_SECRET=change-me-local-dev-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# GCP
GCP_PROJECT_ID=naqla-mvp
GCP_REGION=europe-west1
GCS_BUCKET_NAME=naqla-uploads-dev
CLOUD_TASKS_QUEUE=naqla-ingestion-dev
CLOUD_TASKS_LOCATION=europe-west1

# AI Provider
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key-here

# Worker
WORKER_SERVICE_URL=http://localhost:8001
API_SERVICE_URL=http://localhost:8000
